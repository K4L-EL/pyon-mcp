{
  "name": "pyon-mcp",
  "version": "0.3.0",
  "description": "Pyon MCP connector for existing Quant tools and scoped Wealth client reviews and branding over stdio or authenticated HTTP",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pyon-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run build && npm run smoke && npm run smoke:wealth && npm run smoke:http",
    "smoke:http": "node scripts/http-smoke.mjs",
    "smoke:wealth": "node scripts/smoke-wealth.mjs"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "pyon",
    "trading",
    "backtesting",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K4L-EL/pyon-mcp.git"
  },
  "homepage": "https://github.com/K4L-EL/pyon-mcp#readme",
  "bugs": {
    "url": "https://github.com/K4L-EL/pyon-mcp/issues"
  },
  "author": "Pyon Labs Ltd (https://pyon.io)"
}
